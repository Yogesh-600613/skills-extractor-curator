{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-knowledge:findings:1.0.0",
  "title": "Engineering Findings Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "title",
          "category",
          "technologies",
          "project",
          "repository",
          "module",
          "observed_pattern",
          "implementation_steps",
          "shared_libraries_and_versions",
          "authentication_or_integration_sequence",
          "baseline_or_expected_pattern",
          "baseline_authority",
          "deviation_classification",
          "deviations_and_justifications",
          "alternatives_and_tradeoffs",
          "historical_evolution",
          "evidence_references",
          "verification_status",
          "confidence",
          "normative_status",
          "reuse_scope",
          "known_risks",
          "test_and_validation_evidence",
          "coverage_metric_and_result_if_applicable",
          "golden_reference_candidate",
          "recommendation",
          "candidate_skill_name",
          "approval_status",
          "open_questions"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FND-[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "module": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_pattern": {
            "type": "string"
          },
          "implementation_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shared_libraries_and_versions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "version_source",
                "key_apis",
                "usage_notes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "version_source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "key_apis": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "usage_notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "authentication_or_integration_sequence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "baseline_or_expected_pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseline_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "deviation_classification": {
            "enum": [
              "approved-exception",
              "justified-alternative-pending-approval",
              "unexplained-variation",
              "potential-improvement",
              "confirmed-noncompliance",
              "known-defect",
              "historical-workaround",
              "superseded-design",
              "not-applicable",
              "unknown"
            ]
          },
          "deviations_and_justifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternatives_and_tradeoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "historical_evolution": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_references": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EVD-[A-Za-z0-9_-]+$"
            }
          },
          "verification_status": {
            "enum": [
              "verified",
              "partially-verified",
              "unverified",
              "unknown"
            ]
          },
          "confidence": {
            "enum": [
              "verified",
              "corroborated",
              "inferred",
              "unknown"
            ]
          },
          "normative_status": {
            "enum": [
              "approved-standard",
              "observed-practice",
              "approved-exception",
              "candidate",
              "confirmed-noncompliance",
              "known-defect",
              "historical-only",
              "unresolved"
            ]
          },
          "reuse_scope": {
            "enum": [
              "team-wide",
              "technology-specific",
              "project-specific",
              "not-recommended",
              "unknown"
            ]
          },
          "known_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_and_validation_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage_metric_and_result_if_applicable": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric",
                  "target_percent",
                  "actual_percent",
                  "source"
                ],
                "properties": {
                  "metric": {
                    "enum": [
                      "line",
                      "branch",
                      "instruction",
                      "overall",
                      "new-code",
                      "other",
                      "unknown"
                    ]
                  },
                  "target_percent": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "actual_percent": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exclusions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "golden_reference_candidate": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommendation": {
            "enum": [
              "create-skill",
              "update-skill",
              "merge-skill",
              "keep-existing",
              "retire-skill",
              "permanent-instruction",
              "reference-document",
              "automated-check",
              "no-action",
              "needs-review"
            ]
          },
          "candidate_skill_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_status": {
            "enum": [
              "pending",
              "approved",
              "rejected",
              "approved-with-conditions"
            ]
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
